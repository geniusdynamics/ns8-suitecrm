# Runs in the state directory before the backup
set -e -o pipefail

podman exec mariadb-app sh -c 'exec mariadb-dump -uroot -p"${MARIADB_ROOT_PASSWORD}" \
        --databases suitecrm \
        --default-character-set=utf8mb4 \
        --skip-dump-date \
        --single-transaction \
        --quick \
        --add-drop-table' > suitecrm.sql
