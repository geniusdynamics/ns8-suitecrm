set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# The backup holds secrets.env: restore the database with the same passwords
secret() { grep -m1 "^$1=" secrets.env | cut -d= -f2-; }

# Prepare an initialization script that restores the dump file
mkdir -vp initdb.d
mv -v suitecrm.sql initdb.d
cat - >initdb.d/zz_suitecrm_restore.sh <<'EOS'
# The script is sourced, override entrypoint args and exit:
set -- true
docker_temp_server_stop
exit 0
EOS

# once we exit we remove initdb.d
trap 'rm -rfv initdb.d/' EXIT

# The MariaDB entrypoint loads the dump, then the script stops the container
podman run \
  --rm \
  --network=none \
  --volume=./initdb.d:/docker-entrypoint-initdb.d:Z \
  --volume=mysql-data:/var/lib/mysql/:Z \
  --env=MARIADB_ROOT_PASSWORD="$(secret SUITECRM_DB_ROOT_PASSWORD)" \
  --env=MARIADB_DATABASE=suitecrm \
  --env=MARIADB_USER=suitecrm \
  --env=MARIADB_PASSWORD="$(secret SUITECRM_DB_PASSWORD)" \
  --replace --name=restore_db \
  "${MARIADB_IMAGE}"
