import json
import sys

import agent

request = json.load(sys.stdin)
host = request["host"]

# Settings that are not secret. The passwords come from secrets.env, see the
# systemd units. The containers share the pod network: MariaDB is reached on
# 127.0.0.1.
agent.write_envfile("suitecrm.env", {
    "SUITECRM_DB_HOST": "127.0.0.1",
    "SUITECRM_DB_PORT": "3306",
    "SUITECRM_DB_NAME": "suitecrm",
    "SUITECRM_DB_USER": "suitecrm",
    "SUITECRM_SITE_URL": f"https://{host}",
    "SUITECRM_ADMIN_USER": "admin",
})

agent.write_envfile("mariadb.env", {
    "MARIADB_DATABASE": "suitecrm",
    "MARIADB_USER": "suitecrm",
    "MARIADB_AUTO_UPGRADE": "1",
})
