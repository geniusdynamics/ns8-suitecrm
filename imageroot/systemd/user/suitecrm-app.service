# The entrypoint of the image copies SuiteCRM into the suitecrm-data volume
# and installs it on the first start, then starts Apache on port 8080. The
# unit reports started only when Apache answers.

[Unit]
Description=Podman suitecrm-app.service
BindsTo=suitecrm.service
After=suitecrm.service mariadb-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# SUITECRM_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
# The first start installs SuiteCRM: a start timeout would kill it halfway
TimeoutStartSec=1800
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/suitecrm-app.pid %t/suitecrm-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/suitecrm-app.pid \
    --cidfile %t/suitecrm-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/suitecrm.pod-id --replace -d --name suitecrm-app \
    --env-file=%E/state/suitecrm.env \
    --env=SUITECRM_DB_PASSWORD=${SUITECRM_DB_PASSWORD} \
    --env=SUITECRM_ADMIN_PASSWORD=${SUITECRM_ADMIN_PASSWORD} \
    --volume=suitecrm-data:/var/www/html:Z \
    ${SUITECRM_APP_IMAGE}
ExecStartPost=/usr/bin/bash %E/bin/wait-ready suitecrm-app curl -s -o /dev/null http://127.0.0.1:8080/
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/suitecrm-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/suitecrm-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/suitecrm-app.pid
Type=forking

[Install]
WantedBy=default.target
