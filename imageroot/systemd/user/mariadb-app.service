# Reports started when MariaDB accepts TCP connections: the server that
# initializes a new database does not listen on TCP.

[Unit]
Description=Podman mariadb-app.service
BindsTo=suitecrm.service
After=suitecrm.service
Before=suitecrm-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# SUITECRM_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mariadb-app.pid %t/mariadb-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/mariadb-app.pid \
    --cidfile %t/mariadb-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/suitecrm.pod-id --replace -d --name mariadb-app \
    --env-file=%E/state/mariadb.env \
    --env=MARIADB_ROOT_PASSWORD=${SUITECRM_DB_ROOT_PASSWORD} \
    --env=MARIADB_PASSWORD=${SUITECRM_DB_PASSWORD} \
    --volume=mysql-data:/var/lib/mysql/:Z \
    ${MARIADB_IMAGE} \
    --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci --bind-address=127.0.0.1
ExecStartPost=/usr/bin/bash %E/bin/wait-ready mariadb-app mariadb-admin ping --protocol=tcp -h 127.0.0.1 --silent
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/mariadb-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/mariadb-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/mariadb-app.pid
Type=forking

[Install]
WantedBy=default.target
